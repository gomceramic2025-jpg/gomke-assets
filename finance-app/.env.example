# Sao chép thành .env.local rồi điền. KHÔNG commit .env.local.
# Không điền gì → ứng dụng chạy chế độ cục bộ (không đăng nhập, không đồng bộ).

# --- Supabase (chỉ dùng khóa PUBLISHABLE / anon; KHÔNG BAO GIỜ dán service-role key vào đây) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Email chủ sở hữu (chỉ để giao diện báo sớm; quyền thật được kiểm tra ở máy chủ qua bảng allowed_owners)
VITE_OWNER_EMAIL=

# true: bắt buộc đăng nhập Google trước khi mở ứng dụng (khi đã cấu hình Supabase)
VITE_REQUIRE_LOGIN=false

# --- Sao lưu Google Drive (tùy chọn). Client ID của OAuth Web client, KHÔNG phải client secret ---
VITE_GOOGLE_CLIENT_ID=

# --- Phía máy chủ (Supabase Edge Function ai-proxy). Đặt bằng `supabase secrets set`, KHÔNG đặt trong frontend ---
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-5-5
